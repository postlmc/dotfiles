#!/bin/bash
# /Volumes/Vault is the encrypted sparse bundle (bin/vault). On the MacBook Claude Code is denied
# its contents; elsewhere the same rules are stripped back out.
deny_vault={{ if eq .chezmoi.hostname "unrecognized-device" }}1{{ else }}0{{ end }}
input=$(cat)
[ -z "$input" ] && input="{}"

# Add the rtk PreToolUse rewrite hook only when rtk is on PATH — the hook runs on every Bash
# call, so a missing binary would break all command execution. Rebuilt idempotently below so
# repeated applies never duplicate it and a removed rtk strips it back out.
rtk_present=0
command -v rtk >/dev/null 2>&1 && rtk_present=1

# ACTIVE_AGENT trips the minimal agent-shell branch in .zshrc/.bashrc for CC command execution.
# md-format-hook reflows and lints every Markdown file Claude writes; rebuilt idempotently like rtk.
printf '%s' "$input" | jq --arg home "$HOME" --argjson rtk "$rtk_present" --argjson vault "$deny_vault" '
  . * {
    "env": { "ACTIVE_AGENT": "claude-code" },
    "statusLine": { "type": "command", "command": ($home + "/.claude/statusline-command.sh") },
    "editorMode": "vim"
  }
  | .hooks.PreToolUse = ((.hooks.PreToolUse // []) | map(select(.hooks[0].command != "rtk hook claude")))
  | if $rtk == 1
    then .hooks.PreToolUse += [ { "matcher": "Bash", "hooks": [ { "type": "command", "command": "rtk hook claude" } ] } ]
    else . end
  | if (.hooks.PreToolUse | length) == 0 then del(.hooks.PreToolUse) else . end
  | ($home + "/.local/bin/md-format-hook") as $mdhook
  | .hooks.PostToolUse = ((.hooks.PostToolUse // []) | map(select(.hooks[0].command != $mdhook)))
  | .hooks.PostToolUse += [ { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": $mdhook } ] } ]
  | if .hooks == {} then del(.hooks) else . end
  | ["Read(//Volumes/Vault/**)", "Edit(//Volumes/Vault/**)"] as $vaultrules
  | .permissions.deny = (((.permissions.deny // []) - $vaultrules) + (if $vault == 1 then $vaultrules else [] end))
  | if (.permissions.deny | length) == 0 then del(.permissions.deny) else . end
  | if .permissions == {} then del(.permissions) else . end
'
