#!/bin/bash
# Git pre-commit hook: refuses a commit whose staged Markdown files aren't md-format clean or still
# fail markdownlint. The backstop for edits no AI-tool hook saw.
# Install per repo: ln -s ~/.local/bin/md-precommit .git/hooks/pre-commit
# Checks the working-tree copy of each staged file, so stage the fixed files before committing.

export PATH="${HOME}/.local/bin:${HOME}/.local/share/devbox/global/default/.devbox/nix/profile/default/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"

command -v md-format >/dev/null 2>&1 || exit 0

files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md' '*.markdown')
[[ ${#files[@]} -eq 0 ]] && exit 0

status=0
md-format --check "${files[@]}" || status=1
if command -v markdownlint-cli2 >/dev/null 2>&1; then
    markdownlint-cli2 --config "${HOME}/.markdownlint-cli2.jsonc" "${files[@]}" >/dev/null 2>&1 || {
        markdownlint-cli2 --config "${HOME}/.markdownlint-cli2.jsonc" "${files[@]}" 2>&1 |
            grep -E ':[0-9]+(:[0-9]+)? ' >&2
        status=1
    }
fi

if [[ $status -ne 0 ]]; then
    printf '\nCommit blocked. Run: md-format <files>, fix any remaining lint errors, re-stage.\n' >&2
fi
exit "$status"
