<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.dotfiles.ca-bundle-filter</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/ca-bundle-filter</string>
        <string>--login</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WatchPaths</key>
    <array>
        <string>/etc/ssl/cert.pem</string>
        <string>/opt/homebrew/etc/ca-certificates/cert.pem</string>
        <string>{{ .chezmoi.homeDir }}/.local/share/devbox/global/default/devbox.lock</string>
        <string>{{ .chezmoi.homeDir }}/.local/share/devbox/global/default/.devbox/nix/profile</string>
        <string>/opt/homebrew/Cellar/azure-cli</string>
        <string>{{ .chezmoi.homeDir }}/.local/share/uv/python</string>
        <string>/etc/nix/macos-keychain.crt</string>
    </array>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/ca-bundle-filter.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/ca-bundle-filter.log</string>
</dict>
</plist>
