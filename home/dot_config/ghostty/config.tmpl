# auto-update-channel = tip

# Name as stated from: ghostty --list-fonts
{{- if stat (joinPath .chezmoi.homeDir ".config/local/low_dpi_displays") }}
font-family = FiraCode Nerd Font
{{- else }}
font-family = FiraCode Nerd Font Light
{{- end }}
font-feature = +liga,+dlig,+calt

# To preview, use: ghostty +list-themes
# Name is case-sensitive against the shipped theme file (share/ghostty/themes/Dracula) — this
# worked silently on macOS's typically case-insensitive filesystem but failed outright the first
# time Ghostty actually ran on Linux's case-sensitive one.
theme = Dracula
background-opacity = 0.9
background-blur = 10

# term = xterm-256color

window-width = 132
window-height = 40

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

selection-clear-on-copy = true

# 128MB should be enough for anybody ;)
scrollback-limit = 134217728

shell-integration = detect
shell-integration-features = cursor,sudo,title,path

# Can't make up my mind about this one
# window-inherit-working-directory = false

{{- if eq .chezmoi.os "darwin" }}

# MacOS-specific settings
font-size = 14.5
macos-titlebar-style = native
macos-icon = glass
macos-icon-frame = chrome

# Quick terminal as hotkey reference overlay
quick-terminal-position = center
# Centered on a landscape monitor, the first value is the width and the second the height. That's
# from QuickTerminalSize.swift in v1.3.1; the docs say the opposite. 700px fits the widest hotkeys
# row. Ghostty reuses the quick terminal's last frame over this setting once it has one, even across
# restarts.
quick-terminal-size = 700px,60%
quick-terminal-animation-duration = 0.1
quick-terminal-autohide = true
keybind = ctrl+shift+slash=toggle_quick_terminal

keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

{{- else if eq .chezmoi.os "linux" }}

# Linux-specific settings
# No linux-icon key exists (checked `ghostty +show-config --default` on 1.3.1-4.fc44 — only
# macos-* icon settings are real; icon theming here comes from the .desktop file's Icon= field).
# macOS's 14.5 rendered comically large on this host's actual display. Confirmed via ctrl+minus
# in a live window: four presses (1pt each) from 14.5 landed close, tuned down another .5pt
# from there afterward.
font-size = 10.0

keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
{{- end }}
