# Where a package goes, first match wins:
#   1. This host only (devbox): ~/.config/local/devbox/plugin.json, then `devbox global install`
#   2. Every host, in nixpkgs: home/dot_local/share/devbox/global/default/devbox.json.tmpl
#   3. Every host, Mac GUI app, not in nixpkgs, no cached nix binary, or a vendor companion of a
#      Homebrew package: home/dot_config/homebrew/Brewfile.tmpl
#   4. One project: that project's devbox.json, via `devbox add`
# Then run pkg-up.

# Bootstrap tool — must stay in Homebrew so it can manage everything else
brew "chezmoi"

{{- if eq .chezmoi.os "darwin" }}

# Newer bash (macOS ships 3.2.x)
brew "bash"

# System networking
brew "iproute2mac"

# Developer tools that must stay in Homebrew
brew "dotnet"
brew "openvpn"
brew "rdap"

# macOS-specific utilities
brew "age-plugin-se"

# Fonts
cask "font-fira-code-nerd-font"
cask "font-monaspace"
cask "font-sf-mono-nerd-font-ligaturized"

# Security
cask "1password-cli"
cask "git-credential-manager"
cask "keepassxc"

# GUI applications
cask "appcleaner"
cask "bruno"
cask "herdr-app"
cask "qlmarkdown"
cask "visual-studio-code"

{{- if dig "machine" "personal" false . }}
# Virtualization (personal lab only)
brew "qemu"
brew "vde"

# Database servers (personal dev only — work machines use remote DBs)
brew "postgresql@14"
brew "mysql"

# Security monitoring
cask "knockknock"
cask "osquery"
cask "taskexplorer"

# Personal GUI applications
cask "claude-code@latest"
cask "packetsender"
cask "wireshark-app"
{{- else }}
# PostgreSQL client for connecting to remote databases
brew "postgresql@15"
{{- end }}

# AWS
cask "copilot-cli"

{{- end }}

{{- if dig "development" "docker" false . }}
{{- if eq .chezmoi.os "darwin" }}
# Container tools — macOS has no native container engine, so both the CLI (podman needs a
# VM-backed "podman machine" here) and the GUI come from Homebrew. Linux gets podman from the
# OS image instead (systemd units, SELinux policy, registries.conf already wired up there) and
# podman-compose from nixpkgs — Homebrew's copies would just shadow better-integrated ones.
brew "podman"
brew "podman-compose"
cask "podman-desktop"
{{- end }}
{{- end }}

{{- if dig "cloud" "azure" false . }}
# Azure tools (Homebrew per Microsoft's recommendations)
tap "azure/functions"
tap "azure/kubelogin"
cask "azure-cli"
brew "azcopy"
brew "aztfexport"
brew "azure/functions/azure-functions-core-tools@4"
brew "azure/kubelogin/kubelogin"
{{- end }}

{{- if dig "cloud" "gcloud" false . }}
# Google Cloud tools
cask "gcloud-cli"
{{- end }}

{{- if dig "cloud" "aws" false . }}
# AWS tools
brew "awscli"
{{- end }}

{{- if dig "development" "kubernetes" false . }}
# Kubernetes tools not available in nixpkgs on macOS
brew "calicoctl"
{{- if eq .chezmoi.os "darwin" }}
cask "lens"
{{- end }}
{{- end }}

{{- if dig "tools" "sdr" false . }}
# SDR / hardware driver stack
{{- if eq .chezmoi.os "darwin" }}
brew "airspy"
brew "airspyhf"
brew "esptool"
brew "f3"
brew "hackrf"
brew "soapyrtlsdr"
brew "soapysdr"
{{- end }}
{{- end }}
